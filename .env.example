# Public origin used for canonical links and provider redirects.
NEXT_PUBLIC_SITE_URL=https://nyascans.com

# Comma-separated emails allowed to complete an operator-controlled admin
# promotion. Leave empty until a reviewed bootstrap procedure is scheduled.
NYASCANS_ADMIN_EMAILS=

# Highest-role bootstrap allowlist. Configure only the designated platform
# owner; this role alone can view/export immutable audit events and manage
# protected roles.
NYASCANS_OWNER_EMAILS=

# Payment provider stays disabled until these are configured in Sites.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Connect team payouts. Keep the feature flag disabled until every
# destination account is verified and the fixed conversion has legal approval.
STRIPE_CONNECT_ENABLED=false
TEAM_PAYOUT_CURRENCY=USD
TEAM_PAYOUT_MINOR_PER_ONYX=

# Signed rewarded-ad provider. The URL must be HTTPS and the webhook secret
# must contain at least 32 characters. Temporary access may last 1–168 hours.
AD_REWARD_PROVIDER_URL=
AD_REWARD_WEBHOOK_SECRET=
AD_UNLOCK_HOURS=24

# Transactional email. EMAIL_FROM must use a domain verified in Resend.
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@nyascans.com
EMAIL_API_KEY=

# Optional external search provider.
SEARCH_PROVIDER=d1
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Security and operations.
ADMIN_IP_ALLOWLIST=
SECURITY_ALERT_EMAIL=
SUPPORT_EMAIL=support@nyascans.com

# Legal and regional settings.
DEFAULT_BILLING_CURRENCY=USD
DEFAULT_CONTENT_REGION=GLOBAL
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
